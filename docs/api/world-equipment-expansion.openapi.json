    "/world/nodes/{id}/equipment-expand": {
      "post": {
        "operationId": "worldEquipmentExpand",
        "description": "Owned purchased room only. Immutable purchased policy; initial places included, additional places priced B,2B,... within published area/limit. Room budget pays the original settlement treasury. Optional explicit personal top-up commits together with payment, entitlements, slot activation and storage capacity. Existing equipment and its wear do not change. Old fixed purchases cannot acquire a free expansion policy.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Commit"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./world.openapi.json#/components/schemas/CommandResult"
                }
              }
            }
          },
          "401": {
            "description": "World error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./world.openapi.json#/components/schemas/Error"
