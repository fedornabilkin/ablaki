  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Input": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "top_up": {
            "type": "boolean"
          }
        },
        "required": [
          "quantity",
          "top_up"
        ],
        "additionalProperties": false
      },
      "Commit": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "top_up": {
            "type": "boolean"
          },
          "request_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,80}$"
          },
          "quote_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "expected_revisions": {
            "$ref": "./world.openapi.json#/components/schemas/Revisions"
          }
        },
        "required": [
          "quantity",
          "top_up",
          "request_key",
          "quote_id",
          "expected_revisions"
        ],
        "additionalProperties": false
      },
      "State": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "supported": {
            "type": "boolean"
          },
          "writable": {
            "type": "boolean"
          },
          "available_budget": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$"
          },
          "server_time": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "expansion": {
            "type": "object",
            "properties": {
              "initial_open": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "unlocked": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "limit": {
                "type": "integer",
                "minimum": 2,
                "maximum": 4
              },
              "base_price": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$"
              },
              "storage_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "exposure_class": {
                "type": "string",
                "enum": [
                  "covered",
                  "indoor"
                ]
              },
              "places": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "properties": {
                    "position": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "unlocked": {
                      "type": "boolean"
                    },
                    "price": {
                      "type": "string",
                      "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$"
                    }
                  },
                  "required": [
                    "position",
                    "unlocked",
                    "price"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "initial_open",
              "unlocked",
              "limit",
              "base_price",
              "storage_id",
              "exposure_class",
              "places"
            ],
            "additionalProperties": false,
            "nullable": true
          }
        },
        "required": [
          "node_id",
          "supported",
          "writable",
          "available_budget",
          "server_time",
          "expansion"
        ],
        "additionalProperties": false
      },
      "Terms": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "top_up": {
            "type": "boolean"
          },
          "initial_open": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "unlocked": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "limit": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4
          },
          "unit_prices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "ordinal": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 4
                },
                "price": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$"
                },
                "gross_price": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$"
                }
              },
              "required": [
                "ordinal",
                "price"
              ],
              "additionalProperties": false
            }
          },
          "total": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$"
          },
          "gross_total": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$"
          },
          "discount_bps": {
            "type": "integer",
            "enum": [0, 500]
          },
          "discount_amount": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$"
          },
          "currency": {
            "type": "string",
            "enum": [
              "Cr"
            ]
          },
          "curve": {
            "type": "string",
            "enum": ["linear", "progressive"]
          },
          "policy_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "policy_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "template_revision_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "base_price": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$"
          },
          "source_budget_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "nullable": true
          },
          "available_before": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$"
          },
          "personal_charge": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$"
          },
          "wallet_before": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$",
            "nullable": true
          },
          "wallet_after": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,14})\\.\\d{4}$",
            "nullable": true
          },
          "storage_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "exposure_class": {
            "type": "string",
            "enum": [
              "covered",
              "indoor"
            ]
          },
          "recipient_node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "recipient_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "recipient_account_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "recipient_policy_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "node_id",
          "quantity",
          "top_up",
          "initial_open",
          "unlocked",
          "limit",
          "unit_prices",
          "total",
          "gross_total",
          "discount_bps",
          "discount_amount",
          "currency",
          "curve",
          "policy_id",
          "policy_revision",
          "template_revision_id",
          "base_price",
          "source_budget_id",
          "available_before",
          "personal_charge",
          "wallet_before",
          "wallet_after",
          "storage_id",
          "exposure_class",
          "recipient_node_id",
          "recipient_name",
          "recipient_account_id",
          "recipient_policy_id"
        ],
        "additionalProperties": false
      },
      "Quote": {
        "allOf": [
          {
            "$ref": "./world.openapi.json#/components/schemas/Quote"
          },
          {
            "type": "object",
            "properties": {
              "terms": {
                "$ref": "#/components/schemas/Terms"
              }
            }
          }
        ]
      }
    }
  }
}
