  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "totalCount",
          "pageCount",
          "currentPage",
          "perPage"
        ],
        "properties": {
          "totalCount": {
            "type": "integer",
            "minimum": 0
          },
          "pageCount": {
            "type": "integer",
            "minimum": 0
          },
          "currentPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "perPage": {
            "type": "integer",
            "enum": [
              20
            ]
          }
        }
      },
      "Command": {
        "type": "object",
        "required": [
          "request_key",
          "quote_id",
          "expected_revisions"
        ],
        "properties": {
          "request_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,80}$"
          },
          "quote_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "expected_revisions": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        }
      },
      "Quote": {
        "type": "object",
        "required": [
          "quote_id",
          "expires_at",
          "expected_revisions",
          "terms",
          "server_time"
        ],
        "properties": {
          "quote_id": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "expected_revisions": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "terms": {
            "type": "object"
          },
          "server_time": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "Result": {
        "type": "object",
        "required": [
          "operation_id",
          "request_key",
          "server_time",
          "contract_version",
          "changed_node_ids"
        ],
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "request_key": {
            "type": "string"
          },
          "server_time": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "contract_version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "changed_node_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        }
      },
      "Notification": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "body",
          "created_at",
          "read_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "type": {
            "type": "string",
            "enum": [
              "construction",
              "cultivation",
              "production",
              "npc",
              "quest",
              "progression"
            ]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "read_at": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "nullable": true
          }
        }
      },
      "Preference": {
        "type": "object",
        "required": [
          "type",
          "channel",
          "enabled",
          "quiet_start_minute",
          "quiet_end_minute",
          "timezone",
          "revision"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "construction",
              "cultivation",
              "production",
              "npc",
              "quest",
              "progression"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "in_app"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "quiet_start_minute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1439,
            "nullable": true
          },
          "quiet_end_minute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1439,
            "nullable": true
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone; default Europe/Moscow"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Preferences": {
        "type": "object",
        "required": [
          "items",
          "quiet_hours_behavior"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Preference"
            }
          },
          "quiet_hours_behavior": {
            "type": "string"
          }
        }
      }
    }
  }
}
