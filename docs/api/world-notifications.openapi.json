                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "channel",
                  "enabled",
                  "quiet_start_minute",
                  "quiet_end_minute",
                  "timezone",
                  "expected_revision"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "construction",
                      "cultivation",
                      "production",
                      "npc",
                      "quest",
                      "progression"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "enum": [
                      "in_app"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "quiet_start_minute": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1439,
                    "nullable": true
                  },
                  "quiet_end_minute": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1439,
                    "nullable": true
                  },
                  "timezone": {
                    "type": "string",
                    "description": "IANA timezone; default Europe/Moscow"
                  },
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "description": "POST without quote; expected_revision=0 creates an absent preference. Stale different values return 409; retry with identical values succeeds. Quiet times are both null or both minutes 0..1439 with different values, including overnight ranges. In-app messages remain visible during quiet hours; push delivery is not implemented. Disabled types suppress future delivery, not existing inbox rows."
      }
    }
