  "components": {
    "schemas": {
      "State": {
        "type": "object",
        "required": [
          "node_id",
          "name",
          "operational_status",
          "condition",
          "max_condition",
          "writable",
          "room_count",
          "lodging_count",
          "action",
          "reasons",
          "server_time"
        ],
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "name": {
            "type": "string"
          },
          "operational_status": {
            "type": "string",
            "enum": [
              "planned",
              "constructing",
              "active",
              "paused",
              "damaged",
              "destroyed",
              "archived"
            ]
          },
          "condition": {
            "type": "integer",
            "minimum": 0
          },
          "max_condition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "writable": {
            "type": "boolean"
          },
          "room_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 101
          },
          "lodging_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 101
          },
          "action": {
            "type": "string",
            "enum": [
              "pause",
              "resume",
              null
            ],
            "nullable": true
          },
          "reasons": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string"
            }
          },
          "server_time": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Terms": {
        "type": "object",
        "required": [
          "node_id",
          "name",
          "action",
          "from",
          "to",
          "condition",
          "price",
          "room_ids",
          "closed_lodgings"
        ],
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "name": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "pause",
              "resume"
            ]
          },
          "from": {
            "type": "string",
            "enum": [
              "active",
              "paused"
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "active",
              "paused"
            ]
          },
          "condition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "price": {
            "type": "string",
            "enum": [
              "0.0000"
            ]
          },
          "room_ids": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "closed_lodgings": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "room_id",
                "actor_id",
                "started_at"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "room_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "actor_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "started_at": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "Quote": {
        "allOf": [
          {
            "$ref": "world.openapi.json#/components/schemas/Quote"
          },
          {
            "type": "object",
            "properties": {
              "terms": {
                "$ref": "#/components/schemas/Terms"
              }
            }
          }
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
