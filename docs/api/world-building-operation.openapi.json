    "/world/nodes/{id}/building-pause-preview": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      ],
      "post": {
        "summary": "pause preview",
        "description": "Requires world_read, world_write and storage_v2. Only active <-> paused for a ready owned building with at most 100 own rooms. No shelter, nested plot/building, active construction or foreign lodger. Pause closes current housing intervals; resume does not reassign lodging. Station use and incoming storage operations follow existing building access policy; withdrawal remains available. Equipment exposure, budgets, treasury and debts are unchanged. No charge. Preview expires after 300 seconds; commit revalidates under existing locks, with audit and outbox. Same request key replays the original result.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
