  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "top_up": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Commit": {
        "type": "object",
        "required": [
          "request_key",
          "quote_id",
          "expected_revisions"
        ],
        "properties": {
          "request_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,80}$"
          },
          "quote_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "expected_revisions": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "top_up": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "State": {
        "type": "object",
        "required": [
          "node_id",
          "storage_id",
          "capacity",
          "used",
          "limit",
          "next_price",
          "finance_node_id",
          "writable",
          "server_time"
        ],
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "storage_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "used": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "next_price": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d+\\.\\d{4}$"
          },
          "finance_node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "writable": {
            "type": "boolean"
          },
          "server_time": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Quote": {
        "$ref": "world.openapi.json#/components/schemas/Quote"
      }
    }
  }
