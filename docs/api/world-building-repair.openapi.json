  "components": {
    "schemas": {
      "RepairContractInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "full_price",
          "materials"
        ],
        "properties": {
          "full_price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,14})\\.[0-9]{4}$",
            "description": "Positive price at full damage; no automatic default."
          },
          "materials": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_id",
                "quantity"
              ],
              "properties": {
                "item_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              }
            }
          }
        }
      },
