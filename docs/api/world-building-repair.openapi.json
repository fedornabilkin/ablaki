{
  "openapi": "3.0.3",
  "info": {
    "title": "Ablaki contracted building repair",
    "version": "1.1.0",
    "description": "Schema marker 20. Effective repair terms come from the original purchase or an explicitly accepted supplement. No automatic contracts for legacy purchases. Migration and behavioral acceptance deferred."
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/world/nodes/{id}/building-repair": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      ],
      "get": {
        "summary": "Read building repair contract, proportional costs and shortages",
        "description": "No writes. Reads the original purchase contract or accepted supplement; absent contracts remain unsupported. Requires world_read and storage_v2.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Actual owner required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Node or contractor unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Repair unavailable, materials/budget missing, quote expired or state changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Feature or wallet unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Commit immediate repair",
        "description": "Requires world_write, storage_v2 and active exact wallet. Fixed effective contract from purchase or accepted supplement; ceil(full_price * damage / max_condition) at 0.0001 Cr, ceil each raw material to whole units. Building budget pays original settlement treasury. Personal balance unchanged. Materials only from accessible backpack slots. Only own ready/paused/damaged buildings with own rooms and no construction/shelter/nested estate. Destroyed/archived buildings cannot be repaired. Damaged or stopped buildings remain paused; no lodging restored. Healthy active lodging is preserved. All transfers, consumption, condition, revisions, audit and outbox share a transaction; same key replays original result.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "world-construction.openapi.json#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/CommandResult"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Actual owner required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
