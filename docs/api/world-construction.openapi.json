  "components": {
    "schemas": {
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "plot_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "status": {
            "type": "string",
            "enum": [
              "constructing",
              "paused",
              "completed",
              "cancelled"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "started_at": {
            "type": "integer"
          },
          "finish_at": {
            "type": "integer"
          },
          "remaining_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 604800
          },
          "room_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "nullable": true
          },
          "price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,14})\\.[0-9]{4}$",
            "description": "Exact Cr; maximum 900000000000000.0000."
          },
          "materials": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "item_id",
                "quantity",
                "name"
              ],
              "properties": {
                "item_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "additionalProperties": false
            }
          },
          "demolished": {
            "type": "boolean",
            "description": "Completed building was later demolished. Keep room_id as history, do not link to archived building/room."
          }
        },
        "required": [
          "id",
          "node_id",
          "plot_id",
          "name",
          "status",
          "revision",
          "started_at",
          "finish_at",
          "remaining_seconds",
          "room_id",
          "price",
          "materials",
          "demolished"
        ]
      },
      "State": {
        "type": "object",
        "required": [
          "node_id",
          "items",
          "_meta",
          "writable",
          "server_time"
        ],
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "_meta": {
            "$ref": "world-premises.openapi.json#/components/schemas/Meta"
          },
          "writable": {
            "type": "boolean"
          },
          "server_time": {
            "type": "integer"
          }
        }
      },
      "Command": {
        "type": "object",
        "required": [
          "request_key",
          "quote_id",
          "expected_revisions"
        ],
        "additionalProperties": false,
        "properties": {
          "request_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,80}$"
          },
          "quote_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "expected_revisions": {
            "$ref": "world.openapi.json#/components/schemas/Revisions"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
