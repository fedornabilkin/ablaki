{
  "openapi": "3.0.3",
  "info": {
    "title": "Ablaki timed construction",
    "version": "1.1.0",
    "description": "Schema marker 19. Code only, migrations and behavioral acceptance deferred. Start uses premises-buy on a construction offer. Fixed refund policy returns materials to backpack and releases credits, never recovery storage."
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/world/nodes/{id}/construction": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      ],
      "get": {
        "summary": "Owned campsite or building construction history",
        "description": "Read-only, latest IDs first, 20 per page; filters applied before count. Archived cancelled projects are listed from their plot, not via archived node access. Waiting for worker is not completion.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "",
                "constructing",
                "paused",
                "completed",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Owner required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable node",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Quote/state changed or backpack full; all reserves retained",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
