{
  "openapi": "3.0.3",
  "info": {
    "title": "Garden harvest storage and market",
    "version": "1.0.0",
    "description": "Schema 37. Authenticated players may view active garden offers. Only owner sets price or withdraws; only other players buy. Each batch loses floor(remaining_quantity * 30 / 100) once at harvested_at + 1209600 seconds. GET projects loss without writes; commands settle it atomically. Expired quantity never resets on sale or price changes. Buying debits personal Cr, credits garden treasury with its ordinary tax/loss receipt and grants backpack items in the same command transaction. Full backpack, stale revisions/prices or insufficient credit reject all changes. Idempotency follows the shared CommandBus contract. Harvest storage is separate from generic storage transfer to preserve batch metadata."
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/world/nodes/{id}/harvest": {
      "get": {
        "summary": "Garden warehouse and public sale offers",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Harvest"
                }
              }
            }
          }
        }
      }
    },
    "/world/nodes/{id}/harvest-price-preview": {
      "post": {
        "summary": "Preview price",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "inventory_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "price": {
                    "type": "string",
                    "nullable": true,
                    "pattern": "^(0|[1-9][0-9]{0,14})\\.[0-9]{4}$",
                    "description": "Positive exact Cr per unit, or null to remove from sale."
                  }
                },
                "required": [
                  "inventory_id",
                  "price"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "409": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/world/nodes/{id}/harvest-price": {
      "post": {
        "summary": "Execute price",
        "parameters": [
