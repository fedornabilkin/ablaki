  "components": {
    "schemas": {
      "Offer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offer_id",
          "name",
          "template_revision_id",
          "repair",
          "kind",
          "area",
          "available",
          "reasons"
        ],
        "properties": {
          "offer_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "template_revision_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "repair": {
            "$ref": "world-building-repair.openapi.json#/components/schemas/RepairContract"
          },
          "kind": {
            "type": "string",
            "enum": [
              "canopy",
              "workroom",
              "house"
            ]
          },
          "area": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "available": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      },
      "State": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "contract",
          "items",
          "eligible",
          "reasons",
          "writable",
          "_meta",
          "server_time"
        ],
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "repair",
              "template_revision_id",
              "accepted_at"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647,
                "nullable": true
              },
              "source": {
                "type": "string",
                "enum": [
                  "purchase",
                  "supplement"
                ]
              },
              "repair": {
                "$ref": "world-building-repair.openapi.json#/components/schemas/RepairContract"
              },
              "template_revision_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "accepted_at": {
                "type": "integer",
                "minimum": 0
              }
            },
            "nullable": true
          },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Offer"
            }
          },
          "eligible": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "writable": {
            "type": "boolean"
          },
          "_meta": {
            "$ref": "world-premises.openapi.json#/components/schemas/Meta"
          },
          "server_time": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Terms": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "offer_id",
          "purchase_id",
          "building_name",
          "name",
          "template_revision_id",
          "repair",
          "kind",
          "area",
          "price",
          "recipient_node_id",
          "recipient_name"
        ],
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "offer_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "purchase_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "building_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "template_revision_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "repair": {
            "$ref": "world-building-repair.openapi.json#/components/schemas/RepairContract"
          },
          "kind": {
            "type": "string",
            "enum": [
              "canopy",
              "workroom",
              "house"
            ]
          },
          "area": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "price": {
            "type": "string",
            "enum": [
              "0.0000"
            ]
          },
          "recipient_node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "recipient_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "Selection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offer_id"
        ],
        "properties": {
          "offer_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offer_id",
          "request_key",
          "quote_id",
          "expected_revisions"
        ],
        "properties": {
          "offer_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "request_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,80}$"
          },
          "quote_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "expected_revisions": {
            "$ref": "world.openapi.json#/components/schemas/Revisions"
          }
        }
      },
      "Quote": {
        "allOf": [
          {
            "$ref": "world.openapi.json#/components/schemas/Quote"
          },
          {
            "type": "object",
            "properties": {
              "terms": {
                "$ref": "#/components/schemas/Terms"
              }
            }
          }
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
