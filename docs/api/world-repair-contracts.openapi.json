{
  "openapi": "3.0.3",
  "info": {
    "title": "Ablaki repair contract supplements",
    "version": "1.0.0",
    "description": "Schema marker 20. Resumable additive migration, no old purchase backfill. Code only, tests/migration/deployment deferred."
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/world/nodes/{id}/repair-contracts": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      ],
      "get": {
        "summary": "Current repair contract and matching settlement offers",
        "description": "Owner only, no writes. Published offers explicitly enabled for existing purchases, original seller settlement, exact kind and area. SQL filtering before total and pagination, newest IDs first. Existing contract or unsupported building returns reasons and no offers.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Actual building owner required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable node",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Contract already exists, offer withdrawn, incompatible kind/area, unavailable materials or quote changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Schema or feature unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/world/nodes/{id}/repair-contract-preview": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      ],
      "post": {
        "summary": "Preview contract acceptance",
        "description": "Actual owner only. Requires world_write and storage_v2, no wallet debit or inventory mutation. Revalidates offer status, kind/area, purchase/ownership and absence of existing contract under CommandBus locks. Free acceptance fixes future repair terms, not an immediate repair. Original purchase JSON is unchanged. Terms remain valid after offer withdrawal; no replacement or cancellation in this slice. Expiring quote, revisions, atomic unique contract, audit/outbox and same-key replay.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Selection"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "world.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
