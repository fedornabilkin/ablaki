    "/world/nodes/{id}/demolish-preview": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      ],
      "post": {
        "summary": "Preview ordinary demolition",
        "description": "Requires world_read/world_write/storage_v2. No fee, no credit refund or salvage. Explicit quote revalidated under CommandBus locks. Archives building and room, retires empty storages/slots, preserves purchase/entitlements/finance/housing history, records unique demolition receipt and releases purchase footprint exactly once. No forced recovery. Atomic audit/outbox/revisions; identical request key replays result including return_node_id=plot.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
