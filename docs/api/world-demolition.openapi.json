          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      ],
      "get": {
        "summary": "Owned building demolition eligibility and blocking reasons",
        "description": "No writes. Ordinary demolition only: purchased building with original owned active room/plot; no items/active equipment/containers/lodging/construction/orders, nonzero account balances or reserves, open commitments/obligations/receipts/funding lots or external financial children. Shelter/complex/unpurchased buildings excluded.",
