{
  "openapi": "3.0.3",
  "info": {
    "title": "Ablaki World Workspace and Recovery API",
    "version": "1.0.0",
    "description": "Implemented code; not runtime-tested or deployed. Requires world_read/storage_v2, writes require world_write. Storage activation remains gated. Only own local storages are available. Recipe prices and XP use the existing craft engine. Quote terms are recalculated under locks, including wear. New instance:<id> revision. Recovery moves a whole inventory row without changing its physical identity or chest contents; it cannot be used as general-purpose free storage."
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
