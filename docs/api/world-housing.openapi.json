    "schemas": {
      "State": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "supported": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          },
          "writable": {
            "type": "boolean"
          },
          "place": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "plot_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "created_at": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "plot_id",
              "created_at"
            ],
            "additionalProperties": false,
            "nullable": true
          },
          "lodging": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "assigned_at": {
                "type": "integer",
                "minimum": 0
              },
              "protects_now": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "assigned_at",
              "protects_now"
            ],
            "additionalProperties": false,
            "nullable": true
          },
          "current_assignment": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "shelter",
                  "house"
                ]
              },
              "node_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "interval_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "started_at": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "node_id",
              "interval_id",
              "started_at"
            ],
            "additionalProperties": false,
            "nullable": true
          },
          "night_resolution_enabled": {
            "type": "boolean"
          },
          "server_time": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "node_id",
          "supported",
          "active",
          "writable",
          "place",
          "lodging",
          "current_assignment",
          "night_resolution_enabled",
          "server_time"
        ],
        "additionalProperties": false,
        "description": "Owner-only ROOM state. Non-residential room: supported=false, place/lodging=null, writable/active=false. Current assignment identifies the control node: campsite for shelter, room for house. Leave is allowed for an existing assignment even when protection is unavailable. No implicit lodging, healing, calendar activation or money change."
      },
      "Assignment": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "shelter",
              "house"
            ]
          },
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "interval_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "started_at": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "kind",
          "node_id",
          "interval_id",
          "started_at"
        ],
        "additionalProperties": false,
        "nullable": true
      },
      "PreviewInput": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "Command": {
        "type": "object",
        "properties": {
          "request_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,80}$"
          },
          "quote_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "expected_revisions": {
            "$ref": "world.openapi.json#/components/schemas/Revisions"
          }
        },
        "required": [
          "request_key",
          "quote_id",
          "expected_revisions"
        ],
        "additionalProperties": false
      },
      "Terms": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "place_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "plot_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "actor_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "lodging_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "nullable": true
          },
          "price": {
            "type": "string",
            "enum": [
              "0.0000"
            ]
          }
        },
        "required": [
          "node_id",
          "place_id",
          "plot_id",
          "actor_id",
          "lodging_id",
          "price"
        ],
        "additionalProperties": false
      },
      "Quote": {
        "allOf": [
          {
            "$ref": "world.openapi.json#/components/schemas/Quote"
          },
          {
            "type": "object",
            "properties": {
              "terms": {
                "$ref": "#/components/schemas/Terms"
              }
            }
          }
        ]
      }
    }
