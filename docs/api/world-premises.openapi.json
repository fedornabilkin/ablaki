{
  "openapi": "3.0.3",
  "info": {
    "title": "Ablaki ready premises",
    "version": "1.1.0",
    "description": "Implementation contract, schema marker 17 adds house with one unassigned permanent bunk. Not yet deployed or behavior-tested. Ready premises are distinct from timed construction. Purchase terms include config(name/kind/price/area/slots/expansion_limit/expansion_base_price/exposure_class/delivery=ready/lodging_places), template_revision_id, source_budget_id, recipient_node_id/name/account_id/policy_id, available_area and personal_charge=0.0000. Standard command result additionally includes building_id and room_id on purchase. Prices and recipient policy are authoritative server terms."
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
