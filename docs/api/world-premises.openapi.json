  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Publication": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "canopy",
              "workroom",
              "house"
            ]
          },
          "price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,14})\\.[0-9]{4}$",
            "description": "Exact Cr; maximum 900000000000000.0000."
          },
          "area": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "slots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "lodging_places": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "Derived by server: 1 for house, otherwise 0. Client cannot choose a different capacity."
          },
          "expansion_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "Defaults to slots; must be between slots and area."
          },
          "expansion_base_price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,14})\\.[0-9]{4}$",
            "description": "Positive only when expansion_limit exceeds slots; otherwise null. Each successive additional place costs another multiple of this price.",
            "nullable": true
          }
        },
        "required": [
          "name",
          "kind",
          "price",
          "area",
          "slots"
        ],
        "additionalProperties": false,
        "description": "Positive price required. House reserves one unit of area for one permanent bunk; equipment expansion_limit + lodging_places cannot exceed area. A house needs area >= 2. No automatic balancing defaults."
      },
      "Selection": {
        "type": "object",
        "properties": {
          "offer_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "offer_id"
        ],
        "additionalProperties": false
      },
      "Offer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "template_revision_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "canopy",
              "workroom",
              "house"
            ]
          },
          "price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,14})\\.[0-9]{4}$",
            "description": "Exact Cr; maximum 900000000000000.0000."
          },
          "area": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "slots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "lodging_places": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "Derived by server: 1 for house, otherwise 0. Client cannot choose a different capacity."
          },
          "expansion_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "Defaults to slots; must be between slots and area."
          },
          "expansion_base_price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,14})\\.[0-9]{4}$",
            "description": "Positive only when expansion_limit exceeds slots; otherwise null. Each successive additional place costs another multiple of this price.",
            "nullable": true
          },
          "exposure_class": {
            "type": "string",
            "enum": [
              "covered",
              "indoor"
            ]
          }
        },
        "required": [
          "id",
          "template_revision_id",
          "name",
          "kind",
          "price",
          "area",
          "slots",
          "lodging_places",
          "expansion_limit",
