# Existing test checkout: /var/code/ablaki
# Merge these settings into the existing .env; do not overwrite it wholesale.
# Keep the actual existing Compose project name and database credentials/name:
# changing them can select a different volume or fail to authenticate to it.
# "ablaki" is the normal project name for this directory; verify container labels.
APP_ENVIRONMENT=test
COMPOSE_PROJECT_NAME=ablaki
COMPOSE_SUBNET=192.168.22.0/24
APP_BIND_IP=127.0.0.1

# Host nginx proxies the test API domain to 127.0.0.1:19882.
# Example ports/subnet: verify that they are available on the VPS.
PORT_NGINX_API=19882
PORT_NGINX_FRONT=18092
PORT_NGINX_ADMIN=18082
PG_DB_PORT=15432

# Values below are for a new test installation only; preserve an existing DB.
PG_DB_HOST=postgres
PG_DB_NAME=ablaki_test
PG_DB_USER=ablaki_test
PG_DB_PASSWORD=REPLACE_ME

YII_ENV=prod
YII_DEBUG=0
