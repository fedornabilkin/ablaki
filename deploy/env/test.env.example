# Existing test checkout: /var/code/ablaki
# Merge only the required settings into the existing .env; never replace it.
APP_ENVIRONMENT=test

# Test already uses PostgreSQL. Preserve the actual existing values:
# PG_DB_HOST=...
# PG_DB_NAME=...
# PG_DB_USER=...
# PG_DB_PASSWORD=...
# Preserve PG_DB_PORT if already configured; do not assign a new port.
# Do not copy production MYSQL_DB_* values here: they select MySQL in Yii.

# Preserve any existing COMPOSE_PROJECT_NAME; it is not a required new setting.
# Also preserve COMPOSE_SUBNET, APP_BIND_IP, PORT_NGINX_API,
# PORT_NGINX_FRONT, PORT_NGINX_ADMIN and existing database/service settings.
# Configure the system nginx upstream for the actual test API port on this VPS.

YII_ENV=prod
YII_DEBUG=0

# Deployment updates code/vendor and uses normal make up with migrations.
# It does not create a database dump or copy data between environments.
