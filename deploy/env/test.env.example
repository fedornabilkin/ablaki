# Existing test checkout: /var/code/ablaki
# Merge only the required settings into the existing .env; never replace it.
APP_ENVIRONMENT=test
APP_BIND_IP=0.0.0.0
PG_BIND_IP=127.0.0.1
PORT_NGINX_API=3180
PORT_NGINX_ADMIN=3195

# Test already uses PostgreSQL. Preserve the actual existing values:
# PG_DB_HOST=...
# PG_DB_NAME=...
# PG_DB_USER=...
# PG_DB_PASSWORD=...
# Preserve PG_DB_PORT if already configured; do not assign a new port.
# Do not copy production MYSQL_DB_* values here: they select MySQL in Yii.

# Preserve any existing COMPOSE_PROJECT_NAME; it is not a required new setting.
# COMPOSE_SUBNET is no longer used; Docker allocates new networks automatically.
# Preserve PORT_NGINX_FRONT and database/service settings.
# Port 3181 belongs to the SPA on host nginx, not PORT_NGINX_FRONT.
# Public test API: http://94.250.251.94:3180/; admin: http://94.250.251.94:3195/.

# Keep existing YII_ENV/YII_DEBUG and local debug module/IP settings.
# Keep existing vendor including yii2-debug; this example does not enable public debug.

# Deployment runs git pull and make up with migrations; existing vendor is retained.
# It does not create a database dump or copy data between environments.
