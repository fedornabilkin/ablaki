# New production checkout: /var/www/api.ablakin.ru
# Copy to .env only during initial provisioning and replace REPLACE_ME.
# Choose a different password from the test environment.
APP_ENVIRONMENT=production
COMPOSE_PROJECT_NAME=ablaki-production
COMPOSE_SUBNET=192.168.23.0/24
APP_BIND_IP=127.0.0.1

# Host nginx proxies the HTTPS API domain to 127.0.0.1:19881.
# Example ports/subnet: verify that they are available on the VPS.
PORT_NGINX_API=19881
PORT_NGINX_FRONT=18091
PORT_NGINX_ADMIN=18081
PG_DB_PORT=15431

# postgres resolves inside this Compose project's private network.
PG_DB_HOST=postgres
PG_DB_NAME=ablaki_production
PG_DB_USER=ablaki_production
PG_DB_PASSWORD=REPLACE_ME

# Both deployments use production dependencies and disable debug output.
YII_ENV=prod
YII_DEBUG=0
