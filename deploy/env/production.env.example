# Existing production checkout: /var/www/api.ablakin.ru
# Merge only the required settings into the existing .env; never replace it.
APP_ENVIRONMENT=production

# Production already uses MySQL. Preserve the actual existing values:
# MYSQL_DB_HOST=...
# MYSQL_DB_NAME=...
# MYSQL_DB_USER=...
# MYSQL_DB_PASSWORD=...
# Do not create a PostgreSQL database or copy test data for this deployment.

# Preserve any existing COMPOSE_PROJECT_NAME; it is not a required new setting.
# Also preserve COMPOSE_SUBNET, APP_BIND_IP, PORT_NGINX_API,
# PORT_NGINX_FRONT, PORT_NGINX_ADMIN and existing database/service settings.
# Configure the system nginx upstream for the actual API port on this VPS.

# Both deployments use production dependencies and disable debug output.
YII_ENV=prod
YII_DEBUG=0

# Deployment updates code/vendor and uses normal make up with migrations.
# It does not create a database dump or change database credentials.
